# TinaCMS
# Required for Tina Cloud authentication in local/prod environments
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
# Optional build toggle: set true only to bypass TinaCloud checks/indexing.
# Keep unset or false in production if /admin should use TinaCloud.
TINA_SKIP_CLOUD_CHECKS=false
TINA_BUILD=
SKIP_TINA_BUILD=
TINA_BUILD_PORT=4002
TINA_DATALAYER_PORT=9001

# Optional admin protection for /admin and /tina-admin routes.
# If set, middleware requires a matching admin_session cookie.
ADMIN_SESSION_TOKEN=

# Site URL (used for metadata alternates, robots.txt sitemap, and sitemap URLs)
# Use your production URL, e.g. https://webblymedia.com
NEXT_PUBLIC_SITE_URL=
NODE_ENV=production

# Existing project envs
DISCORD_WEBHOOK_URL=
FORM_DISCORD_WEBHOOK_URL=
NEXT_PUBLIC_CRISP_WEBSITE_ID=
